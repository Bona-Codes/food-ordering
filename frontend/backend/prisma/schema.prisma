generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  address_id  Int           @id @default(autoincrement())
  country     String?       @db.VarChar(100)
  city        String?       @db.VarChar(100)
  sub_city    String?       @db.VarChar(100)
  street      String?       @db.VarChar(255)
  postal_code String?       @db.VarChar(20)
  latitude    Decimal?      @db.Decimal(10, 8)
  longitude   Decimal?      @db.Decimal(11, 8)
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  customers   customers[]
  deliveries  deliveries[]
  orders      orders[]
  restaurants restaurants[]
}

model admins {
  admin_id         Int           @id @default(autoincrement())
  user_id          Int           @unique
  permission_level String?       @db.VarChar(50)
  users            users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  restaurants      restaurants[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  cart_item_id Int        @id @default(autoincrement())
  cart_id      Int
  menu_item_id Int
  quantity     Int
  unit_price   Decimal    @db.Decimal(10, 2)
  carts        carts      @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: NoAction)
  menu_items   menu_items @relation(fields: [menu_item_id], references: [menu_item_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cart_id], map: "idx_cart_items_cart")
}

model carts {
  cart_id       Int          @id @default(autoincrement())
  customer_id   Int
  restaurant_id Int
  is_active     Boolean?     @default(true)
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  updated_at    DateTime?    @default(now()) @db.Timestamp(6)
  cart_items    cart_items[]
  customers     customers    @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
  restaurants   restaurants  @relation(fields: [restaurant_id], references: [restaurant_id], onDelete: Cascade, onUpdate: NoAction)
}

model categories {
  category_id        Int          @id @default(autoincrement())
  name               String       @db.VarChar(100)
  parent_category_id Int?
  categories         categories?  @relation("categoriesTocategories", fields: [parent_category_id], references: [category_id], onUpdate: NoAction)
  other_categories   categories[] @relation("categoriesTocategories")
  menu_items         menu_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  coupon_id        Int       @id @default(autoincrement())
  code             String    @unique @db.VarChar(50)
  discount_type    String    @db.VarChar(20)
  discount_value   Decimal   @db.Decimal(10, 2)
  min_order_amount Decimal?  @default(0) @db.Decimal(10, 2)
  max_uses         Int?
  start_date       DateTime? @db.Date
  expiry_date      DateTime? @db.Date
  is_active        Boolean?  @default(true)
  orders           orders[]
}

model customer_badges {
  badge_id       Int       @id @default(autoincrement())
  customer_id    Int
  badge_name     String    @db.VarChar(100)
  minimum_orders Int
  award_date     DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  customers      customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
}

model customers {
  customer_id       Int               @id @default(autoincrement())
  user_id           Int               @unique
  address_id        Int?
  registration_date DateTime?         @default(now()) @db.Timestamp(6)
  carts             carts[]
  customer_badges   customer_badges[]
  addresses         addresses?        @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders[]
  reviews           reviews[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deliveries {
  delivery_id             Int                       @id @default(autoincrement())
  order_id                Int                       @unique
  driver_id               Int?
  address_id              Int?
  delivery_fee            Decimal?                  @default(0) @db.Decimal(10, 2)
  delivery_status         String?                   @db.VarChar(30)
  estimated_time          DateTime?                 @db.Timestamp(6)
  picked_up_at            DateTime?                 @db.Timestamp(6)
  delivered_at            DateTime?                 @db.Timestamp(6)
  addresses               addresses?                @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction)
  drivers                 drivers?                  @relation(fields: [driver_id], references: [driver_id], onDelete: NoAction, onUpdate: NoAction)
  orders                  orders                    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  driver_delivery_history driver_delivery_history[]

  @@index([driver_id], map: "idx_delivery_driver")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model driver_delivery_history {
  history_id                Int        @id @default(autoincrement())
  driver_id                 Int
  delivery_id               Int
  delivery_date             DateTime   @db.Timestamp(6)
  delivery_duration_minutes Int?
  customer_rating           Int?
  delivery_status           String?    @db.VarChar(30)
  deliveries                deliveries @relation(fields: [delivery_id], references: [delivery_id], onDelete: NoAction, onUpdate: NoAction)
  drivers                   drivers    @relation(fields: [driver_id], references: [driver_id], onDelete: NoAction, onUpdate: NoAction)
}

model driver_phones {
  driver_phone_id Int     @id @default(autoincrement())
  driver_id       Int
  phone_number    String  @db.VarChar(20)
  drivers         drivers @relation(fields: [driver_id], references: [driver_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([driver_id, phone_number])
}

model drivers {
  driver_id               Int                       @id @default(autoincrement())
  user_id                 Int                       @unique
  vehicle_type            String?                   @db.VarChar(50)
  vehicle_number          String?                   @db.VarChar(50)
  license_number          String?                   @unique @db.VarChar(100)
  is_available            Boolean?                  @default(true)
  is_active               Boolean?                  @default(true)
  join_date               DateTime?                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  deliveries              deliveries[]
  driver_delivery_history driver_delivery_history[]
  driver_phones           driver_phones[]
  users                   users                     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model menu_items {
  menu_item_id        Int           @id @default(autoincrement())
  restaurant_id       Int
  category_id         Int?
  name                String        @db.VarChar(255)
  description         String?
  image_url           String?
  price               Decimal       @db.Decimal(10, 2)
  preparation_time    Int?
  availability_status Boolean?      @default(true)
  created_at          DateTime?     @default(now()) @db.Timestamp(6)
  cart_items          cart_items[]
  categories          categories?   @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)
  restaurants         restaurants   @relation(fields: [restaurant_id], references: [restaurant_id], onDelete: Cascade, onUpdate: NoAction)
  order_items         order_items[]

  @@index([category_id], map: "idx_menu_category")
  @@index([restaurant_id], map: "idx_menu_restaurant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  order_item_id Int        @id @default(autoincrement())
  order_id      Int
  menu_item_id  Int
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)
  menu_items    menu_items @relation(fields: [menu_item_id], references: [menu_item_id], onDelete: NoAction, onUpdate: NoAction)
  orders        orders     @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order")
}

model order_status_history {
  status_id       Int       @id @default(autoincrement())
  order_id        Int
  status          String    @db.VarChar(30)
  previous_status String?   @db.VarChar(30)
  changed_by      Int?
  changed_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  orders          orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  order_id             Int                    @id @default(autoincrement())
  customer_id          Int
  restaurant_id        Int
  address_id           Int?
  coupon_id            Int?
  order_date           DateTime?              @default(now()) @db.Timestamp(6)
  subtotal             Decimal                @db.Decimal(10, 2)
  discount_amount      Decimal?               @default(0) @db.Decimal(10, 2)
  delivery_fee         Decimal?               @default(0) @db.Decimal(10, 2)
  tax_amount           Decimal?               @default(0) @db.Decimal(10, 2)
  total_amount         Decimal                @db.Decimal(10, 2)
  order_status         String?                @default("pending") @db.VarChar(30)
  deliveries           deliveries?
  order_items          order_items[]
  order_status_history order_status_history[]
  addresses            addresses?             @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction)
  coupons              coupons?               @relation(fields: [coupon_id], references: [coupon_id], onDelete: NoAction, onUpdate: NoAction)
  customers            customers              @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  restaurants          restaurants            @relation(fields: [restaurant_id], references: [restaurant_id], onDelete: NoAction, onUpdate: NoAction)
  payments             payments[]

  @@index([customer_id], map: "idx_orders_customer")
  @@index([restaurant_id], map: "idx_orders_restaurant")
  @@index([order_status], map: "idx_orders_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  payment_id            Int       @id @default(autoincrement())
  order_id              Int
  amount                Decimal   @db.Decimal(10, 2)
  payment_method        String?   @db.VarChar(30)
  payment_status        String?   @db.VarChar(30)
  transaction_reference String?   @db.VarChar(255)
  gateway_response      String?
  paid_at               DateTime? @default(now()) @db.Timestamp(6)
  orders                orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_payments_order")
}

model restaurant_contacts {
  contact_id    Int         @id @default(autoincrement())
  restaurant_id Int
  contact_type  String?     @db.VarChar(50)
  contact_value String      @db.VarChar(255)
  restaurants   restaurants @relation(fields: [restaurant_id], references: [restaurant_id], onDelete: Cascade, onUpdate: NoAction)
}

model restaurant_owners {
  owner_id      Int           @id @default(autoincrement())
  user_id       Int           @unique
  business_name String?       @db.VarChar(255)
  users         users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  restaurants   restaurants[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model restaurants {
  restaurant_id        Int                   @id @default(autoincrement())
  owner_id             Int
  approved_by_admin_id Int?
  address_id           Int?
  name                 String                @db.VarChar(255)
  description          String?
  logo_url             String?
  email                String?               @db.VarChar(255)
  phone                String?               @db.VarChar(20)
  opening_time         DateTime?             @db.Time(6)
  closing_time         DateTime?             @db.Time(6)
  is_approved          Boolean?              @default(false)
  is_active            Boolean?              @default(true)
  status               String?               @default("pending") @db.VarChar(30)
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  carts                carts[]
  menu_items           menu_items[]
  orders               orders[]
  restaurant_contacts  restaurant_contacts[]
  addresses            addresses?            @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction)
  admins               admins?               @relation(fields: [approved_by_admin_id], references: [admin_id], onDelete: NoAction, onUpdate: NoAction)
  restaurant_owners    restaurant_owners     @relation(fields: [owner_id], references: [owner_id], onDelete: Cascade, onUpdate: NoAction)
  reviews              reviews[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  review_id     Int         @id @default(autoincrement())
  customer_id   Int
  restaurant_id Int
  rating        Int
  comment       String?
  review_date   DateTime?   @default(now()) @db.Timestamp(6)
  customers     customers   @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
  restaurants   restaurants @relation(fields: [restaurant_id], references: [restaurant_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([restaurant_id], map: "idx_reviews_restaurant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id              Int                    @id @default(autoincrement())
  first_name           String                 @db.VarChar(100)
  last_name            String                 @db.VarChar(100)
  email                String                 @unique @db.VarChar(255)
  password_hash        String
  phone_number         String?                @unique @db.VarChar(20)
  role                 String                 @db.VarChar(30)
  is_verified          Boolean?               @default(false)
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  admins               admins?
  customers            customers?
  drivers              drivers?
  order_status_history order_status_history[]
  restaurant_owners    restaurant_owners?

  @@index([email], map: "idx_users_email")
}
